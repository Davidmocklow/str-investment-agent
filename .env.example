# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ── Zillow (RapidAPI) ─────────────────────────────────────────────────────────
# Required for live property listings. Without this, the scan uses seeded example data.
# Sign up free at: https://rapidapi.com/apimaker/api/zillow-com1
# Basic plan ($10/mo) gives 1,000 requests/month — enough for weekly scans.
RAPIDAPI_KEY=

# ── Alert email delivery ──────────────────────────────────────────────────────
# Where to send CRITICAL/HIGH alerts immediately when they fire.
# Also set this as a GitHub Actions secret (repo Settings → Secrets).
ALERT_TO_EMAIL=david.mocklow@growthprotocol.ai

# ── Future: AirDNA (market STR data) ─────────────────────────────────────────
# When connected, replaces seeded market occupancy/ADR with live AirDNA data.
# AIRDNA_API_KEY=
